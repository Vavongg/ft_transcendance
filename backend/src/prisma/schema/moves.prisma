model Move {
    id           Int          @id @default(autoincrement())
    name         String       @unique
    accurancy   Int?
    effectChance Int?
    pp  Int?
    priority     Int?
    power        Int?
    category    CategoryClass?
    type         String
  
    category  CategoryClass?

    pokemons     Pokemon[]   @relation("PokemonMoves")
    ailments     Ailment[]   @relation("AilmentMoves")
}

enum CategoryClass {
    PHYSICAL
    SPECIAL
    STATUS
}

model Ailment {
    id        Int    @id @default(autoincrement())
    name      String @unique
    //nameFR    String?
    //nameDE    String?
    movesFrom Move[] @relation("AilmentMoves")
}

