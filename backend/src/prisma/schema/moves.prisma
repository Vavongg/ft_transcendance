model Move {
    id           Int    @id
    name         String @unique
    accurancy    Int?
    effectChance Int?
    pp           Int?
    priority     Int?
    power        Int?

    //Propriété/effet secondaire de l'attaque
    minHits       Int?
    maxHits       Int?
    minTurns      Int?
    maxTurns      Int?
    drain         Int?
    healing       Int?
    critRate      Int?
    ailmentChance Int?
    flinchChance  Int? // Chance de modifier un stat du target
    statChance    Int?

    // Relation avec les autres modèles
    damageClass MoveDamageClass[] @relation("DamageClass")
    ailments    MovesAilment[]    @relation("AilmentMoves")
    pokemons    Pokemon[]         @relation("PokemonMoves")
    type        Type[]            @relation("MoveType")
}

model MoveDamageClass {
    id    Int    @id @default(autoincrement()) // 3
    name  String @unique
    moves Move[] @relation("DamageClass")
}

model MovesAilment {
    id    Int    @id @default(autoincrement()) //askip il en a 22
    name  String @unique
    moves Move[] @relation("AilmentMoves")
}
