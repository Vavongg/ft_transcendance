model Type {
    id          Int       @id
    name        String    @unique
    spritesType String?
    pokemons    Pokemon[] @relation("PokemonType")
    moves       Move[]    @relation("MoveType")

    // Relations réflexives 
    doubleDamageTo   Type[] @relation("DoubleDamage")
    doubleDamageFrom Type[] @relation("DoubleDamage")

    halfDamageTo   Type[] @relation("HalfDamage")
    halfDamageFrom Type[] @relation("HalfDamage")

    noDamageTo   Type[] @relation("NoDamage")
    noDamageFrom Type[] @relation("NoDamage")
}
